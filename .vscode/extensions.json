{
  "recommendations": [
    // We recommend using https://marketplace.visualstudio.com/items?itemName=astral-sh.ty instead of Microsoft's Pylance lsp.
    // We use uv for managing our python venvs, so using this extension will match the linting/typechecking that CI uses (via `make ci` under clients/py/).
    "astral-sh.ty",
    "bierner.markdown-mermaid", // mermaid in markdown preview
    "pomdtr.excalidraw-editor" // opens .excalidraw(.svg/.png) files as live editors
  ],
  "unwantedRecommendations": [
    // We use astral's ty extension which uses uv as the LSP instead of pylance/pyright.
    "ms-python.vscode-pylance"
  ]
}
