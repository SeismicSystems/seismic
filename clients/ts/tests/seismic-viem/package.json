{
  "name": "seismic-viem-test-runner",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:consumer:types": "tsc --project consumer/tsconfig.json",
    "test:unit": "bun test src/viem-unit.test.ts src/gas-payment.test.ts src/gas-payment-routing.test.ts src/transaction-response.test.ts"
  },
  "devDependencies": {
    "viem": "2.x",
    "seismic-viem": "workspace:*",
    "seismic-viem-tests": "workspace:*"
  }
}
