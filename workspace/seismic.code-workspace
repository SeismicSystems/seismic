	"settings": {
		// We ignore all contract submodules because we basically never make changes to them.
		// The paths seem to be relative to the seismic root (first repo in the workspace).
		"git.ignoredRepositories": [
			"contracts/lib/forge-std",
			"contracts/lib/openzeppelin-contracts",
			"contracts/lib/solady",
			"../seismic-solidity/deps/nlohmann-json",
			"../seismic-solidity/deps/range-v3",
			"../seismic-solidity/deps/fmtlib",
		],
		"rust-analyzer.rustfmt.extraArgs": [
			"+nightly"
		],
		// Enable all features so that we can see and edit all files, even those gated by some features.
		// rust-analyzer applies one feature set to every repo in this window, and
		// "all" is the only value that works across them: a list of feature names
		// errors out in the repos that do not define those names.
		//
		// The tradeoff is that "all" is a configuration nobody actually builds:
		//   - Alternative features all resolve one way. reth prefers jemalloc when
		//     jemalloc and snmalloc are both on, so the snmalloc arm reads as dead
		//     code here even though it is what an snmalloc build compiles.
		//   - Test doubles win over the real path. attested-tls gates on
		//     `any(test, feature = "mock")`, so mock platform metadata and a
		//     prewarm-free PCCS are what you see, while the production arms and
		//     the errors they raise grey out.
		// Diagnostics here can therefore differ from CI, which builds specific
		// feature sets. Comment this line out to analyse default features instead
		// when you need the view a real build gets.
		"rust-analyzer.cargo.features": "all",
		// Give rust-analyzer its own artifact directory, target/rust-analyzer. It
		// checks with every feature enabled while terminal builds use defaults, so
		// sharing target/debug makes the two invalidate each other on every save.
		// The cost is a second set of artifacts per repo.
		"rust-analyzer.cargo.targetDir": true,
		// Analyse crates as they are opened. Priming the whole dependency graph
		// up front costs several GB of memory per window, which is expensive in this workspace
		// that contains so many different repos.
		"rust-analyzer.cachePriming.enable": false,
		// Silence the "cyclic deps" warnings that flood the server log. They are
		// dev-dependency cycles, which Cargo allows: rust-analyzer keeps one node
		// per package and does not separate dev-deps from normal deps, so the
		// standard "A dev-depends on B, B depends on A" pattern always looks like a
		// cycle to it. Most of ours come from upstream reth (reth-trie-db and
		// reth-provider dev-depend on each other, and so on), so there is nothing
		// to fix on our side.
		//
		// The warning is logged by add_dep_inner in
		// https://github.com/rust-lang/rust-analyzer/blob/master/crates/project-model/src/workspace.rs
		// which is the only tracing::warn! in that module — everything else there
		// is tracing::error!, so raising just this module to "error" loses nothing.
		// "warn" is rust-analyzer's own default filter, kept here for every other
		// module. RA_LOG is a tracing Targets filter, hence the module::path syntax.
		"rust-analyzer.server.extraEnv": {
			"RA_LOG": "warn,project_model::workspace=error"
		},
	}
}
